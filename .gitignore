# Dependencies
node_modules/

# Builds
/dist/

# Env files (never commit real secrets)
.env
.env.local
.env.*
.tfvars.*
!.env.example

# IDE
.idea
*.iml
.vscode

# Sprint 374: Secure file deployment
# All secrets (env vars + credential files) stored in .secure.{ENV}/ directories
# NEVER COMMIT ACTUAL CREDENTIALS - only directory structure allowed

# Block all .secure.* files and directories by default
.secure.local
.secure.local.*
.secure.*

# Allow specific directory structure (.gitignore/.gitkeep inside directories)
!.secure.local.example
!**/.secure.local.example
!.secure.local/
!.secure.staging/
!.secure.prod/
!.secure.*/.gitignore
!.secure.*/.gitkeep
# Local .terraform directories
.terraform

# Terraform state files and backups
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Terraform variable files (potentially containing sensitive data)
# Note: Consider including specific .tfvars if they are not sensitive and need to be versioned.
*.tfvars
*.tfvars.json

# Terraform override files (often for local development and not meant for version control)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files (output of terraform plan -out=tfplan)
*tfplan*

# Terraform CLI configuration files
.terraformrc
terraform.rc

# Dependency lock file (should generally be committed for consistent provider versions)
# Remove this line if you choose to commit .terraform.lock.hcl
# .terraform.lock.hcl

# macOS specific files
.DS_Store
Thumbs.db

# TypeScript build/cache artifacts
*.tsbuildinfo
.ts-node/

# Test coverage and Jest caches
coverage/
.nyc_output/
.jest/
.jest-cache/
jest-stare/

# Linting and tool caches
.eslintcache
.cache/

# Firebase local emulator
.firebase/
firebase-debug.log*
.bitbrat.json

# CDKTF and generated infra output
infrastructure/cdktf/out/
cdktf.out/
/infrastructure/cdktf/out/

.output.txt

# Scratch / fixture / output artifacts that must never be committed (sprint-323 hygiene).
# Fake/dummy credentials (e.g. a local GOOGLE_APPLICATION_CREDENTIALS stub) — never commit creds.
dummy-creds.json
*-creds.json
# Ad-hoc rule/routing/JSONLogic scratch fixtures dropped at the repo root.
/route.json
/test.json
# Captured validator stdout.
/validation_output.txt
validation_output.txt

# Junie-specific Agent configuration
.junie/

.scratch/

# Sprint 358: Agent-dev ephemeral execution contexts
# These are created by tests and MCP tools, cleaned up automatically
.brat/ephemeral-contexts.yaml
env/agent-dev-*/
infrastructure/docker-compose/docker-compose.agent-dev-*.yaml

# Sprint 375: Docker Compose merge temporary files
# Generated during deployment when merging service-specific compose files
# These should never be committed (cleaned up automatically)
*.merged.tmp
docker-compose.*.merged.yaml
infrastructure/docker-compose/*.merged.yaml

# Sprint 375: Base image cache key
# Generated during deployment to track base image changes
# Auto-regenerated on each build, no need to commit
.base-image-cache-key

