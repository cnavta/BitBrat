# .env.agent-dev.template
# BitBrat Platform - Agent-Dev Environment Template
#
# This template provides default configuration for agent-dev execution contexts.
# When provisioning an agent-dev context, these values are merged with:
#   1. Template defaults (this file)
#   2. User overrides (provision parameters)
#   3. Context-specific values (auto-generated passwords, context name)
#
# Sprint 26 T2.1: Comprehensive environment variable defaults for agent-dev
# Reference: planning/sprint-26-c0qwvh/implementation-plan.md

# =============================================================================
# REQUIRED PLATFORM VARIABLES
# =============================================================================
# These variables MUST be set for the platform to function

# --- LLM Configuration (Required) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BOT_SYSTEM_PROMPT=You are a helpful assistant for a Twitch streamer. Be concise, friendly, and helpful.

# OpenAI API Configuration
OPENAI_API_KEY=sk-local-dev-stub
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_MS=30000

# Service-specific LLM Configuration
# LLM Bot
LLM_BOT_LLM_PROVIDER=openai
LLM_BOT_LLM_MODEL=gpt-4o-mini
LLM_BOT_LLM_BASE_URL=
LLM_BOT_LLM_API_KEY=
LLM_BOT_FF_LLM_PROMPT_LOGGING=false

# Query Analyzer
QUERY_ANALYZER_LLM_PROVIDER=openai
QUERY_ANALYZER_LLM_MODEL=gpt-4o-mini
QUERY_ANALYZER_LLM_BASE_URL=
QUERY_ANALYZER_LLM_API_KEY=
QUERY_ANALYZER_FF_LLM_PROMPT_LOGGING=false

# --- Infrastructure Connection Strings (Required) ---
# These are auto-configured for agent-dev Docker Compose environments
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://bitbrat:bitbrat@postgres:5432/bitbrat
NATS_URL=nats://nats:4222

# --- Message Bus Configuration (Required) ---
MESSAGE_BUS_DRIVER=nats
BUS_PREFIX=bitbrat

# --- Persistence Configuration (Required) ---
PERSISTENCE_DRIVER=postgres
PERSISTENCE_SNAPSHOT_MODE=all
PERSISTENCE_INCLUDE_RAW_PAYLOADS=true
PERSISTENCE_TTL_DAYS=30
PERSISTENCE_MAX_SNAPSHOT_BYTES=1048576

# --- Logging (Required) ---
LOG_LEVEL=info

# --- Service Configuration (Required) ---
PORT=3000
NODE_ENV=development

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Control platform behavior for testing and development

# API Gateway - Allow anonymous WebSocket connections (useful for testing)
API_GATEWAY_ALLOW_ANONYMOUS_WS=true

# LLM Bot Behavioral Features
LLM_BOT_BEHAVIORAL_GATING_ENABLED=false
LLM_BOT_BEHAVIORAL_GUIDANCE_ENABLED=false
LLM_BOT_BEHAVIORAL_TOOL_FILTER_ENABLED=false
LLM_BOT_TONE_STYLE_ENABLED=false
LLM_BOT_RISK_RESPONSE_MODE=warn

# LLM Bot Memory Configuration
LLM_BOT_MEMORY_MAX_MESSAGES=50
LLM_BOT_MEMORY_MAX_CHARS=10000
LLM_BOT_INSTANCE_MEM_MAX_MSGS=100
LLM_BOT_INSTANCE_MEM_MAX_KEYS=1000
LLM_BOT_INSTANCE_MEM_MAX_CHARS=50000
LLM_BOT_INSTANCE_MEM_TTL_MS=3600000

# Disposition Service (Risk Analysis)
DISPOSITION_ENABLED=false
DISPOSITION_WINDOW_MS=5000
DISPOSITION_MIN_EVENTS=3
DISPOSITION_MAX_EVENTS=10
DISPOSITION_PUBLISH_UPDATES=true
DISPOSITION_SNAPSHOT_TTL_MS=300000
DISPOSITION_MODERATION_ASSIST_ENABLED=false
DISPOSITION_PROMPT_INJECTION_ENABLED=false

# Reflex (Event Caching)
REFLEX_CACHE_POLL_INTERVAL_MS=100

# Claim Check (Temporary Event Storage)
CLAIM_CHECK_DEFAULT_TTL_SECONDS=300
CLAIM_CHECK_MAX_TTL_SECONDS=3600
CLAIM_CHECK_MAX_EVENT_SIZE_BYTES=1048576
CLAIM_CHECK_MAX_BLOB_SIZE_BYTES=10485760

# Image Generation Rate Limiting
IMAGE_GEN_RATE_LIMIT_MS=5000

# =============================================================================
# OPTIONAL PLATFORM INTEGRATIONS
# =============================================================================
# These integrations are optional. Leave blank if not using.

# --- Slack Integration (Optional) ---
# Required: SLACK_BOT_TOKEN, SLACK_APP_TOKEN, SLACK_SIGNING_SECRET
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# --- Discord Integration (Optional) ---
# Required: DISCORD_BOT_TOKEN, DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_ENABLED=false
DISCORD_OAUTH_SCOPES=bot applications.commands
DISCORD_OAUTH_PERMISSIONS=2147483648
DISCORD_REDIRECT_URI=http://localhost:3009/oauth/discord/callback

# --- Twitch Integration (Optional) ---
# Required: TWITCH_CLIENT_ID, TWITCH_CLIENT_SECRET, TWITCH_BOT_USERNAME, TWITCH_CHANNELS
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_USERNAME=
TWITCH_CHANNELS=
TWITCH_OAUTH_SCOPES=chat:read chat:edit moderator:read:followers channel:read:subscriptions

# --- Twilio Integration (Optional) ---
# Required: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_CHAT_SERVICE_SID=
TWILIO_ENABLED=false

# --- OBS WebSocket Integration (Optional) ---
# For OBS MCP server (stream overlay control)
OBS_WEBSOCKET_URL=
OBS_WEBSOCKET_PASSWORD=
OBS_WEBSOCKET_SELF_SIGNED=false

# =============================================================================
# MCP (MODEL CONTEXT PROTOCOL) CONFIGURATION
# =============================================================================
# Configuration for MCP servers and tool gateway

# MCP Authentication (Required for MCP servers)
MCP_AUTH_TOKEN=local-dev-mcp-token

# MCP Transport (stdio or http)
MCP_TRANSPORT=stdio

# =============================================================================
# OAUTH & AUTHENTICATION
# =============================================================================
# OAuth flow configuration

OAUTH_STATE_SECRET=local-dev-state-secret

# =============================================================================
# DEBUG & DEVELOPMENT
# =============================================================================
# Debug users for elevated privileges (comma-separated lists)

DEBUG_USERS_TWITCH=
DEBUG_USERS_DISCORD=
DEBUG_USERS_SLACK=

# =============================================================================
# CLOUD RUN METADATA (Auto-populated in cloud, optional locally)
# =============================================================================
# These are set by Google Cloud Run, safe to leave blank locally

K_SERVICE=
K_REVISION=
K_CONFIGURATION=

# =============================================================================
# CONTEXT-SPECIFIC VARIABLES (Auto-Generated)
# =============================================================================
# The following variables are automatically set during agent-dev provision:
#
# BITBRAT_CONTEXT=agent-dev-<unique-id>
#   - Execution context name
#   - Auto-generated during provision
#
# POSTGRES_PASSWORD=<random>
#   - PostgreSQL password
#   - Auto-generated for security
#
# POSTGRES_USER=bitbrat
#   - PostgreSQL username
#   - Fixed for consistency
#
# POSTGRES_DB=bitbrat
#   - PostgreSQL database name
#   - Fixed for consistency

# =============================================================================
# NOTES
# =============================================================================
#
# For production deployments, ensure you:
# 1. Replace all stub API keys with real credentials
# 2. Use strong passwords for infrastructure services
# 3. Enable relevant integrations by providing credentials
# 4. Adjust feature flags based on production requirements
# 5. Review logging levels (use 'warn' or 'error' in production)
#
# For local development:
# 1. Copy this template to .secure.local/.env
# 2. Fill in API keys for integrations you want to test
# 3. Use stub values (sk-local-dev-stub) for quick iteration
#
# For agent-dev contexts:
# - This template is automatically used during provision
# - Override specific values via provision parameters
# - Context-specific values are auto-generated
#
# Documentation:
# - Environment Variables: documentation/reference/environment-variables.md
# - Agent-Dev Contexts: documentation/guides/agent-dev-contexts.md
# - Secrets Management: documentation/guides/secrets-management.md
