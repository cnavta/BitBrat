/**
 * <%= platformTitle %> Connector Adapter
 * Generated by: brat integration create
 * Platform: <%= platformName %>
 *
 * Implements IngressConnector interface to integrate <%= platformTitle %> with BitBrat's
 * ingress-egress service.
 *
 * Documentation: <%= docsUrl %>
 *
 * @since Sprint <%= sprintNumber || '13' %>
 */

import type {
  IngressConnector,
  ConnectorSnapshot,
  ConnectorMetadata,
} from '../core';
import type { <%= platformClass %>IngressClient, <%= platformClass %>DebugSnapshot } from './<%= platformName %>-ingress-client';
import { logger } from '../../../common/logging';
import { IConfig } from '../../../types';

/**
 * <%= platformClass %>ConnectorAdapter
 *
 * Bridges <%= platformTitle %> client with BitBrat's ingress system.
 *
 * Responsibilities:
 * - Lifecycle management (start/stop)
 * - State reporting (getSnapshot)
 * - Egress (sendText, sendDM if supported)
 * - Metadata (getMetadata)
 */
export class <%= platformClass %>ConnectorAdapter implements IngressConnector {
  constructor(
    private readonly client: <%= platformClass %>IngressClient,
    private readonly config?: IConfig
  ) {}

  /**
   * Starts the underlying <%= platformTitle %> client.
   */
  async start(): Promise<void> {
    await this.client.start();
  }

  /**
   * Stops the underlying <%= platformTitle %> client.
   */
  async stop(): Promise<void> {
    await this.client.stop();
  }

  /**
   * Returns a snapshot of the connector state.
   *
   * Maps <%= platformTitle %> client state to standard ConnectorSnapshot format.
   */
  getSnapshot(): ConnectorSnapshot {
    const s: <%= platformClass %>DebugSnapshot = this.client.getSnapshot();
    return {
      state: s.state,
      id: this.config?.<%= platformName %>BotId || '<%= platformName %>-bot',
      displayName: '<%= platformTitle %> Bot',
      lastError: s.lastError ? { message: s.lastError } : null,
      counters: s.counters ? { ...s.counters } : undefined,
      lastMessageAt: s.lastMessageAt,
    } as ConnectorSnapshot & Record<string, unknown>;
  }

  /**
   * Sends text message to <%= platformTitle %> channel.
   *
   * @param text - Message content
   * @param target - Channel/conversation ID (optional, platform-specific)
   */
  async sendText(text: string, target?: string): Promise<void> {
    logger.debug('<%= platformName %>.adapter.sendText', { target, textLength: text?.length });
    await this.client.sendText(text, target);
  }

  /**
   * Returns connector metadata for <%= platformTitle %>.
   *
   * This metadata describes the platform's capabilities and is used by
   * the ingress-egress service for routing and validation.
   *
   * TODO: Update capabilities to match <%= platformTitle %>'s actual features
   */
  getMetadata(): ConnectorMetadata {
    return {
      platform: '<%= platformName %>',
      version: '1.0.0',
      capabilities: {
        ingress: {
          method: 'realtime', // or 'webhook' or 'hybrid'
          realtime: true,
          webhook: false,
        },
        egress: {
          chat: true,
          dm: false, // Set to true if <%= platformTitle %> supports DMs
          reactions: false, // Set to true if <%= platformTitle %> supports reactions
          threads: false, // Set to true if <%= platformTitle %> supports threads
        },
        moderation: {
          ban: false,
          kick: false,
          timeout: false,
        },
      },
      requiredScopes: [
        // TODO: List required <%= platformTitle %> API scopes/permissions
        // Example: 'messages:read', 'messages:write'
      ],
      docs: '<%= docsUrl %>',
    };
  }
}
