# <%= platformName %> Chat Message Mapping
# Generated by: brat integration create
# Platform: <%= platformName %>
# Documentation: <%= docsUrl %>
#
# Maps <%= platformName %> chat messages to BitBrat's chat.message.v1 internal event type.

platformEvent: message
internalEventType: chat.message.v1

# Default priority (0) - adjust if you have multiple mappings
priority: 0

# Optional filter to narrow down which events match this mapping
# Uncomment and modify based on your platform's event structure
# filter:
#   "==":
#     - var: type
#     - message

fieldMapping:
  # Required fields (MUST be present in your platform events)
  # TODO: Update these paths to match your platform's event structure
  userId: user.id
  channelId: channel.id

  # Optional fields with fallbacks
  userName:
    path: user.name
    fallbacks:
      - user.username
      - user.id

  messageText: text
  messageId: id
  timestamp: timestamp

  # Custom fields for platform-specific data
  # Add any additional fields your platform provides
  custom:
    # Example: platform-specific metadata
    # platform.version: version
    # platform.source: source

metadata:
  description: <%= platformName %> chat message
  platformDocUrl: <%= docsUrl %>
  createdBy: brat integration create
  createdAt: "<%= createdAt %>"
  notes: |
    This is a scaffolded configuration. You MUST update the field mappings
    to match <%= platformName %>'s actual event structure.

    Test your mapping with:
      npm run brat -- integration test <%= platformName %> --event message --fixture <path-to-fixture>
