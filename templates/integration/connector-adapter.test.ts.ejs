import { <%= platformClass %>ConnectorAdapter } from './connector-adapter';
import { <%= platformClass %>IngressClient } from './<%= platformName %>-ingress-client';
import { IConfig } from '../../../types';

describe('<%= platformClass %>ConnectorAdapter', () => {
  let mockClient: jest.Mocked<<%= platformClass %>IngressClient>;
  let adapter: <%= platformClass %>ConnectorAdapter;
  let mockConfig: Partial<IConfig>;

  beforeEach(() => {
    // Mock client
    mockClient = {
      start: jest.fn().mockResolvedValue(undefined),
      stop: jest.fn().mockResolvedValue(undefined),
      getSnapshot: jest.fn().mockReturnValue({
        state: 'CONNECTED',
        counters: { received: 10, published: 10, failed: 0 },
        lastMessageAt: '2026-08-15T00:00:00.000Z',
      }),
      sendText: jest.fn().mockResolvedValue(undefined),
    } as any;

    mockConfig = {
      <%= platformName %>Enabled: true,
      <%= platformName %>BotId: '<%= platformName %>-test-bot',
    };

    adapter = new <%= platformClass %>ConnectorAdapter(mockClient, mockConfig as IConfig);
  });

  describe('Lifecycle', () => {
    it('should start the client', async () => {
      await adapter.start();
      expect(mockClient.start).toHaveBeenCalled();
    });

    it('should stop the client', async () => {
      await adapter.stop();
      expect(mockClient.stop).toHaveBeenCalled();
    });
  });

  describe('getSnapshot', () => {
    it('should return connector snapshot', () => {
      const snapshot = adapter.getSnapshot();

      expect(snapshot.state).toBe('CONNECTED');
      expect(snapshot.id).toBe('<%= platformName %>-test-bot');
      expect(snapshot.counters).toEqual({ received: 10, published: 10, failed: 0 });
    });

    it('should handle null last error', () => {
      mockClient.getSnapshot.mockReturnValue({
        state: 'CONNECTED',
        lastError: null,
      });

      const snapshot = adapter.getSnapshot();

      expect(snapshot.lastError).toBeNull();
    });

    it('should map error message', () => {
      mockClient.getSnapshot.mockReturnValue({
        state: 'ERROR',
        lastError: 'Connection failed',
      });

      const snapshot = adapter.getSnapshot();

      expect(snapshot.lastError).toEqual({ message: 'Connection failed' });
    });
  });

  describe('sendText', () => {
    it('should delegate to client', async () => {
      await adapter.sendText('Hello <%= platformTitle %>!', 'channel-123');

      expect(mockClient.sendText).toHaveBeenCalledWith(
        'Hello <%= platformTitle %>!',
        'channel-123'
      );
    });

    it('should handle errors from client', async () => {
      mockClient.sendText.mockRejectedValue(new Error('<%= platformTitle %> API error'));

      await expect(
        adapter.sendText('Test', 'channel-456')
      ).rejects.toThrow('<%= platformTitle %> API error');
    });
  });

  describe('getMetadata', () => {
    it('should return connector metadata', () => {
      const metadata = adapter.getMetadata();

      expect(metadata.platform).toBe('<%= platformName %>');
      expect(metadata.version).toBe('1.0.0');
      expect(metadata.capabilities).toBeDefined();
      expect(metadata.capabilities.ingress).toBeDefined();
      expect(metadata.capabilities.egress).toBeDefined();
    });

    it('should include documentation URL', () => {
      const metadata = adapter.getMetadata();

      expect(metadata.docs).toBe('<%= docsUrl %>');
    });
  });
});

